# ==============================================================================
# LeetCode Tracker OAuth Backend Configuration
# ==============================================================================
# This file serves as a template. In production on Render, DO NOT use a .env file.
# Instead, set these explicitly as Environment Variables in the Render dashboard.

# 1. GitHub OAuth App Client ID
# Obtain this from your GitHub Developer Settings -> OAuth Apps.
# Used by the backend to identify the app during the code exchange.
# It is safe to expose this, but keep it matched with the extension.
GITHUB_CLIENT_ID=your_github_client_id

# 2. GitHub OAuth App Client Secret
# Obtain this from your GitHub Developer Settings -> OAuth Apps.
# CRITICAL: This is highly sensitive. It MUST ONLY exist on the backend.
# Never expose this in the extension code or in the frontend.
GITHUB_CLIENT_SECRET=your_github_client_secret

# 3. GitHub Redirect URI
# The exact callback URL generated by Firefox for your extension.
# In the extension, you get this via `browser.identity.getRedirectURL("github")`.
# Example: moz-extension://d4400a4d-075b-4ba3-ab29-65b169bb8e7d/github
# The backend validates the incoming request against this URI for security.
GITHUB_REDIRECT_URI=moz-extension://your_extension_id/github